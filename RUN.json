{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "main:app",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "JWT_SECRET": {
          "external": true,
          "degraded_without": "POST /api/auth/register and POST /api/auth/login answer 503"
        },
        "DATABASE_URL": {
          "dev": "sqlite:///./closet.db"
        },
        "UPLOAD_DIR": {
          "dev": "backend/uploads"
        },
        "FRONTEND_ORIGIN": {
          "dev": "http://localhost:5173"
        }
      }
    }
  ]
}
